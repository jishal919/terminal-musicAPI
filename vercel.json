{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "SAAVN_BASE_URL":        "https://jiosaavn-api-beta.vercel.app",
    "CACHE_TTL_SEARCH":      "300",
    "CACHE_TTL_METADATA":    "3600",
    "MIN_CONFIDENCE_SCORE":  "0.35",
    "DEFAULT_LANGUAGE":      "english,hindi",
    "MAX_SEARCH_CANDIDATES": "20",
    "REQUEST_TIMEOUT_MS":    "7000",
    "RATE_LIMIT_WINDOW_MS":  "60000",
    "RATE_LIMIT_MAX":        "60",
    "NODE_ENV":              "production"
  }
}
